local p = game.Players.LocalPlayer
local pgui = p:WaitForChild("PlayerGui")

if pgui:FindFirstChild("NovaFixed") then pgui.NovaFixed:Destroy() end

local sg = Instance.new("ScreenGui", pgui)
sg.Name = "NovaFixed"
sg.ResetOnSpawn = false

local frame = Instance.new("Frame", sg)
frame.Size = UDim2.new(0, 140, 0, 50)
frame.Position = UDim2.new(0.5, -70, 0.2, 0)
frame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
frame.BorderSizePixel = 2
frame.Active = true
frame.Draggable = true

local btn = Instance.new("TextButton", frame)
btn.Size = UDim2.new(1, 0, 1, 0)
btn.Text = "AUTO-KILL ⚡"
btn.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
btn.TextColor3 = Color3.fromRGB(255, 255, 255)
btn.Font = Enum.Font.SourceSansBold
btn.TextSize = 18

btn.MouseButton1Click:Connect(function()
    local tool = p.Character:FindFirstChildOfClass("Tool") or p.Backpack:FindFirstChildOfClass("Tool")
    if tool then
        tool.Parent = p.Character
        for _, v in pairs(game.Players:GetPlayers()) do
            if v ~= p and v.Character and v.Character:FindFirstChild("HumanoidRootPart") then
                local target = v.Character:FindFirstChild("UpperTorso") or v.Character:FindFirstChild("Torso")
                if tool.Name == "Knife" then
                    firetouchinterest(target, tool.Handle, 0)
                    firetouchinterest(target, tool.Handle, 1)
                elseif tool.Name == "Gun" then
                    local args = { = target.Position, = v.Character.HumanoidRootPart}
                    if tool:FindFirstChild("KnifeServer") then tool.KnifeServer.Shoot:InvokeServer(unpack(args)) end
                end
            end
        end
        btn.Text = "¡LISTO! ✅"
        task.wait(0.5)
        btn.Text = "AUTO-KILL ⚡"
    else
        btn.Text = "SACA ARMA ⚠️"
        task.wait(0.5)
        btn.Text = "AUTO-KILL ⚡"
    end
end)
