lbl.BackgroundTransparency = 1
lbl.Text = NuevoNombre
lbl.Font = Enum.Font.GothamBold
lbl.TextSize = 14
lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
lbl.RichText = true
lbl.TextStrokeTransparency = 0.5
lbl.Parent = bGui
end
end

